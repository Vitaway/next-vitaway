NEXT_PUBLIC_ENVENTORY_API_URL=https://care-api.vitaway.org
# Visits, organizations, and referral coaches use this.
# Falls back to https://care-api.vitaway.org when the variable is empty.
# NEXT_PUBLIC_BOOKING_API_URL=https://care-api.vitaway.org

NEXT_PUBLIC_IREMBOPAY_JS_URL=
NEXT_PUBLIC_IREMBOPAY_PUBLIC_KEY

NEXT_PUBLIC_URL=

# Optional Gmail SMTP for contact form (preferred).
# If unset, messages still go to support@vitaway.org via FormSubmit.
NEXT_EMAIL_USER=
NEXT_EMAIL_PASS=

# Web Push for the installed PWA. Same value as core-backend WEB_PUSH_VAPID_PUBLIC_KEY (public, not secret).
# When empty the app reads it from GET /api/v1/mobile/web-push/public-key.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Vitaway Plus PWA (/app) API. Separate from NEXT_PUBLIC_ENVENTORY_API_URL, which the marketing site uses.
# Empty means https://care-api.vitaway.org, the same API the mobile app uses.
NEXT_PUBLIC_PLUS_API_URL=
