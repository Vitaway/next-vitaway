NEXT_PUBLIC_ENVENTORY_API_URL=
# Point the marketing site at core-backend (public consumer APIs + Laravel-compat /api/* aliases):
# NEXT_PUBLIC_ENVENTORY_API_URL=http://127.0.0.1:3020
# Bookings always use this when set. If the site URL is still the old Laravel app on port 8001,
# the form sends the visit to core-backend so the confirmation email can go out.
# NEXT_PUBLIC_BOOKING_API_URL=http://127.0.0.1:3020
# Production example: NEXT_PUBLIC_ENVENTORY_API_URL=https://vitaway.keyypress.com

NEXT_PUBLIC_IREMBOPAY_JS_URL=
NEXT_PUBLIC_IREMBOPAY_PUBLIC_KEY

NEXT_PUBLIC_URL=

# Optional Gmail SMTP for contact form (preferred).
# If unset, messages still go to support@vitaway.org via FormSubmit.
NEXT_EMAIL_USER=
NEXT_EMAIL_PASS=
